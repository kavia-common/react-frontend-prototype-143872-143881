@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="hero">
    <div class="hero-inner">
        <h1 class="title">
            Welcome to <span class="accent">Ocean Professional</span>
        </h1>
        <p class="subtitle">
            Modern, clean ASP.NET Core MVC port of the demo project, featuring a light/dark theme toggle.
        </p>
        <div class="actions">
            <a class="btn btn-primary" href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener">
                Get Started with ASP.NET Core
            </a>
            <a class="btn btn-ghost" href="https://reactjs.org" target="_blank" rel="noopener">
                Learn React (original demo)
            </a>
        </div>
    </div>
</section>

<section class="cards">
    <div class="card">
        <h3>Theme</h3>
        <p>Blue & amber accents, subtle gradients, rounded corners, and smooth transitions.</p>
    </div>
    <div class="card">
        <h3>Layout</h3>
        <p>Header with navigation, central content area, and footer.</p>
    </div>
    <div class="card">
        <h3>Health</h3>
        <p>Check <code>/health</code> for basic app health metadata.</p>
    </div>
</section>
